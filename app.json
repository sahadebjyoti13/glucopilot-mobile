{
  "expo": {
    "name": "GlucoPilot",
    "slug": "glucopilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0e1a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.glucopilot.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "GlucoPilot connects to your ESP32 insulin pump on local WiFi."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0e1a"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "ACTIVITY_RECOGNITION"
      ],
      "package": "com.glucopilot.app"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-sensors",
        {
          "motionPermission": "GlucoPilot uses motion sensors to detect physical activity for contextual monitoring."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "59aed4d4-f65c-406e-b8e4-9bc1bb81be1a"
      }
    }
  }
}
