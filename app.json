{
  "expo": {
    "name": "GlucoPilot",
    "slug": "glucopilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0e1a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.glucopilot.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "GlucoPilot connects to your ESP32 insulin pump on local WiFi."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0e1a"
      },
      "package": "com.glucopilot.app",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
